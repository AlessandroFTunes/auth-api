# Senha do Postgres, crua (usada pelo container do banco)
POSTGRES_PASSWORD=troque-esta-senha
# Mesma senha, mas codificada para URL (/ vira %2F, @ vira %40, etc.)
DATABASEURL=postgres://auth:troque-esta-senha@auth-postgres:5432/auth_api
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Domínio público da API (precisa existir como hostname no Cloudflare Tunnel)
API_HOST=auth.exemplo.com
